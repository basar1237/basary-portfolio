# Optional. Microsoft Clarity project id (https://clarity.microsoft.com → Settings → Overview).
# A default is hardcoded in src/components/Clarity.tsx, so this is only needed to
# override or disable it. Clarity is skipped automatically during `next dev`.
NEXT_PUBLIC_CLARITY_ID=

# Google Analytics 4 measurement id (https://analytics.google.com → Admin → Data streams → Web).
# Looks like G-XXXXXXXXXX. GA is disabled until this is set, and skipped during `next dev`.
NEXT_PUBLIC_GA_ID=
